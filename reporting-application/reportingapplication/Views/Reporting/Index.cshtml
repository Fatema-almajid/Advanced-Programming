@using reportingApplication.Controllers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Training & Certification Report";
}
@model ReportingViewModel
<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="fw-bold">Training & Certification Report</h1>
            <p class="text-muted mb-0">Real-time operational metrics for training coordinators</p>
        </div>
        <div class="col-md-4 d-flex justify-content-end gap-2">
            <a href="@Url.Action("ExportPdf", "Reporting")" target="_blank"
               class="btn btn-danger">
                <i class="bi bi-file-pdf"></i> Export PDF
            </a>
            <a href="@Url.Action("Logout", "Login")" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.SessionMetrics.Any())
    {
        var m = Model.SessionMetrics.First();
        <div class="row g-3 mb-5">
            <div class="col-12"><h4 class="fw-semibold border-bottom pb-2">Session Overview</h4></div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Sessions</p>
                        <h2 class="fw-bold text-primary mb-0">@m.TotalSessions</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Enrollments</p>
                        <h2 class="fw-bold text-success mb-0">@m.TotalEnrollments</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Avg Enrollments / Session</p>
                        <h2 class="fw-bold text-info mb-0">@m.AverageEnrollmentsPerSession</h2>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.RevenueReport.Any())
    {
        var rev = Model.RevenueReport.First();
        <div class="row g-3 mb-5">
            <div class="col-12"><h4 class="fw-semibold border-bottom pb-2">Revenue Summary</h4></div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Revenue</p>
                        <h2 class="fw-bold text-success mb-0">
                            BD @rev.TotalRevenue.ToString("N2")
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Completed Payments</p>
                        <h2 class="fw-bold text-success mb-0">@rev.CompletedPayments</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Pending Payments</p>
                        <h2 class="fw-bold text-warning mb-0">@rev.PendingPayments</h2>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.CertificationRates.Any())
    {
        var cert = Model.CertificationRates.First();
        <div class="row g-3 mb-5">
            <div class="col-12"><h4 class="fw-semibold border-bottom pb-2">Certification Completion</h4></div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Certifications</p>
                        <h2 class="fw-bold text-primary mb-0">@cert.TotalCertifications</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Enrollments</p>
                        <h2 class="fw-bold mb-0">@cert.TotalEnrollments</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted small fw-bold text-uppercase mb-1">Completion Rate</p>
                        <h2 class="fw-bold mb-0
                                @(cert.CompletionRate >= 70 ? "text-success" :
                                                          cert.CompletionRate >= 40 ? "text-warning" : "text-danger")">
                                                                                                                     @cert.CompletionRate%
                                                                                                                 </h2>
                                                                                                                 <div class="progress mt-2" style="height: 8px;">
                                                                                                                     <div class="progress-bar
                                    @(cert.CompletionRate >= 70 ? "bg-success" :
                                                                   cert.CompletionRate >= 40 ? "bg-warning" : "bg-danger")"
                             style="width: @cert.CompletionRate%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        }

    <div class="row g-4 mb-5">
        <!-- Enrollment by Course - Bar Chart -->
        @if (Model.EnrollmentByCourse.Any())
        {
            <div class="col-md-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="fw-semibold mb-0">Enrollment by Course</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="enrollmentChart" height="220"></canvas>
                    </div>
                </div>
            </div>
        }
        <!-- Instructor Workload - Doughnut Chart -->
        @if (Model.InstructorWorkload.Any())
        {
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="fw-semibold mb-0">Instructor Workload</h5>
                    </div>
                    <div class="card-body d-flex justify-content-center align-items-center">
                        <canvas id="instructorChart" height="220"></canvas>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-5">
        <!-- Enrollment Table -->
        @if (Model.EnrollmentByCourse.Any())
        {
            <div class="col-md-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="fw-semibold mb-0">Enrollment Statistics by Course</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Course Name</th>
                                        <th class="text-center">Enrollments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in Model.EnrollmentByCourse.OrderByDescending(x => x.EnrollmentCount))
                                    {
                                        <tr>
                                            <td>@e.CourseName</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary rounded-pill">@e.EnrollmentCount</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        <!-- Instructor Workload Table -->
        @if (Model.InstructorWorkload.Any())
        {
            <div class="col-md-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="fw-semibold mb-0">Instructor Workload</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Instructor Name</th>
                                        <th class="text-center">Sessions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inst in Model.InstructorWorkload.OrderByDescending(x => x.SessionCount))
                                    {
                                        <tr>
                                            <td>@inst.InstructorName</td>
                                            <td class="text-center">@inst.SessionCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    @if (Model.EnrollmentByCourse.Any())
    {
            <text>
            const enrollCtx = document.getElementById('enrollmentChart');
            if (enrollCtx) {
                new Chart(enrollCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.EnrollmentByCourse.Select(e => $"'{e.CourseName}'")))],
                        datasets: [{
                            label: 'Enrollments',
                            data: [@string.Join(",", Model.EnrollmentByCourse.Select(e => e.EnrollmentCount))],
                            backgroundColor: 'rgba(13, 110, 253, 0.75)',
                            borderColor: 'rgba(13, 110, 253, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1 } }
                        }
                    }
                });
            }
            </text>
    }
    @if (Model.InstructorWorkload.Any())
    {
            <text>
            const instrCtx = document.getElementById('instructorChart');
            if (instrCtx) {
                const colors = ['#0d6efd','#198754','#ffc107','#dc3545','#0dcaf0','#6f42c1'];
                new Chart(instrCtx, {
                    type: 'doughnut',
                    data: {
        labels: [@Html.Raw(string.Join(",", Model.InstructorWorkload.Select(i => $"'{i.InstructorName}'")))],
                                datasets: [{
                            data: [@string.Join(",", Model.InstructorWorkload.Select(i => i.SessionCount))],
                            backgroundColor: colors.slice(0, @Model.InstructorWorkload.Count),
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
            </text>
    }
</script>