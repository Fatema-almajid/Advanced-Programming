@{
    Layout = null;
    ViewData["Title"] = "Reports — Training Coordinator";
}
@model reportingApplication.Controllers.ReportingData

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <style>
        :root {
            --bg:#0d1117;--surface:#161b22;--surface2:#1e2530;--border:#2a3040;
            --accent:#e8a020;--accent2:#2f9fd8;--success:#3fb950;--danger:#f85149;
            --text:#e6edf3;--muted:#8b949e;--faint:#30363d;
            --mono:'Courier New',monospace;--body:'Segoe UI',system-ui,sans-serif;
            --r:8px;--rl:12px;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{height:100%;width:100%}
        body{background:var(--bg);color:var(--text);font-family:var(--body);font-size:14px;display:flex;height:100vh;margin:0;padding:0;overflow:hidden}
        aside{width:220px;height:100vh;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
        .brand{padding:20px 16px 16px;border-bottom:1px solid var(--border)}
        .brand-title{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
        .brand-sub{font-size:11px;color:var(--muted);margin-top:2px}
        nav{padding:12px 8px;flex:1}
        .nav-section{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:8px 8px 4px;margin-top:8px}
        .nav-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r);cursor:pointer;color:var(--muted);font-size:13px;transition:background .15s,color .15s;user-select:none;border:none;background:none;width:100%;text-align:left}
        .nav-item:hover{background:var(--surface2);color:var(--text)}
        .nav-item.active{background:rgba(232,160,32,.12);color:var(--accent);font-weight:600}
        .api-badge{margin:8px 16px 16px;padding:8px 10px;background:var(--surface2);border-radius:var(--r);border:1px solid var(--border);font-size:11px;color:var(--muted)}
        .api-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--success);margin-right:5px;vertical-align:middle}
        main{flex:1;padding:28px 32px;overflow:auto;display:block;height:100vh}
        .page{display:none}.page.active{display:block}
        .page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border)}
        .page-title{font-size:22px;font-weight:700}.page-sub{font-size:12px;color:var(--muted);margin-top:3px}
        .metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:28px}
        .metric-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);padding:16px 18px;position:relative;overflow:hidden}
        .metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--mc-color,var(--accent))}
        .metric-label{font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
        .metric-value{font-size:28px;font-weight:700;font-family:var(--mono);line-height:1}
        .metric-delta{font-size:11px;color:var(--muted);margin-top:6px}
        .metric-delta.up{color:var(--success)}.metric-delta.down{color:var(--danger)}
        .charts-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:24px}
        .chart-panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);padding:20px}
        .chart-panel-title{font-size:13px;font-weight:600;margin-bottom:4px}
        .chart-panel-sub{font-size:11px;color:var(--muted);margin-bottom:16px}
        .chart-wrap{position:relative;width:100%}
        .table-panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;margin-bottom:24px}
        .table-panel-header{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
        .table-panel-title{font-size:13px;font-weight:600}
        table{width:100%;border-collapse:collapse;font-size:13px}
        thead th{background:var(--surface2);text-align:left;padding:10px 16px;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)}
        tbody tr{border-bottom:1px solid var(--faint)}tbody tr:last-child{border-bottom:none}
        tbody tr:hover{background:var(--surface2)}tbody td{padding:11px 16px}
        .td-m{color:var(--muted)}
        .badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600}
        .bg{background:rgba(63,185,80,.15);color:#3fb950}.ba{background:rgba(232,160,32,.15);color:#e8a020}
        .br{background:rgba(248,81,73,.15);color:#f85149}.bb{background:rgba(47,159,216,.15);color:#2f9fd8}
        .bgr{background:rgba(139,148,158,.15);color:#8b949e}
        .pb-wrap{background:var(--faint);border-radius:4px;height:6px;overflow:hidden;margin-top:4px}
        .pb-fill{height:100%;border-radius:4px;background:var(--accent);transition:width .5s}
        .pb-fill.g{background:var(--success)}.pb-fill.b{background:var(--accent2)}
        .error-box{display:flex;align-items:center;gap:12px;padding:16px 20px;background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.3);border-radius:var(--r);color:#f85149;font-size:13px;margin-bottom:16px}
        .cert-row{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--faint)}
        .cert-row:last-child{border-bottom:none}
        .cert-name{font-weight:600;font-size:13px;flex:1;min-width:0}
        .cert-bar{flex:2;min-width:80px}
        .cert-bar-sub{font-size:11px;color:var(--muted);margin-top:3px}
        .cert-count{font-size:12px;color:var(--muted);min-width:110px;text-align:right}
        .cert-pct{font-size:12px;font-family:var(--mono);color:var(--accent);min-width:36px;text-align:right}
        .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
    </style>
</head>
<body>

<aside>
    <div class="brand">
        <div class="brand-title">&#9642; Reports</div>
        <div class="brand-sub">Training Coordinator</div>
    </div>
    <nav>
        <div class="nav-section">Analytics</div>
        <button class="nav-item active" onclick="showPage('overview',this)">&#9632;&nbsp; Overview</button>
        <button class="nav-item" onclick="showPage('enrollment',this)">&#9632;&nbsp; Enrollment Stats</button>
        <button class="nav-item" onclick="showPage('instructors',this)">&#9632;&nbsp; Instructor Workload</button>
        <button class="nav-item" onclick="showPage('certifications',this)">&#9632;&nbsp; Certifications</button>
        <div class="nav-section">Financial</div>
        <button class="nav-item" onclick="showPage('revenue',this)">&#9632;&nbsp; Revenue &amp; Payments</button>
        <div class="nav-section">Quality</div>
        <button class="nav-item" onclick="showPage('assessments',this)">&#9632;&nbsp; Assessments</button>
        <button class="nav-item" onclick="showPage('capacity',this)">&#9632;&nbsp; Capacity &amp; Rooms</button>
    </nav>
    <div class="api-badge">
        <span class="api-dot"></span> Server-side Data
    </div>
</aside>

<main>
    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <div class="error-box">
            &#9888;&nbsp;<strong>Error</strong> — @ViewBag.Error
        </div>
    }

    <div id="page-overview" class="page active">
        <div class="page-header">
            <div><div class="page-title">Overview</div><div class="page-sub">Key performance indicators and trends</div></div>
        </div>
        <div id="overview-content"></div>
    </div>

    <div id="page-enrollment" class="page">
        <div class="page-header">
            <div><div class="page-title">Enrollment Statistics</div><div class="page-sub">Trainees per course, status breakdown, and completion rates</div></div>
        </div>
        <div id="enrollment-content"></div>
    </div>

    <div id="page-instructors" class="page">
        <div class="page-header">
            <div><div class="page-title">Instructor Workload</div><div class="page-sub">Sessions taught, hours delivered, and utilization</div></div>
        </div>
        <div id="instructors-content"></div>
    </div>

    <div id="page-certifications" class="page">
        <div class="page-header">
            <div><div class="page-title">Certification Tracking</div><div class="page-sub">Completion rates per track and eligible trainees</div></div>
        </div>
        <div id="certifications-content"></div>
    </div>

    <div id="page-revenue" class="page">
        <div class="page-header">
            <div><div class="page-title">Revenue &amp; Payments</div><div class="page-sub">Collected fees, outstanding balances, and overdue accounts</div></div>
        </div>
        <div id="revenue-content"></div>
    </div>

    <div id="page-assessments" class="page">
        <div class="page-header">
            <div><div class="page-title">Assessment Results</div><div class="page-sub">Pass / fail rates by course and instructor</div></div>
        </div>
        <div id="assessments-content"></div>
    </div>

    <div id="page-capacity" class="page">
        <div class="page-header">
            <div><div class="page-title">Capacity &amp; Room Utilization</div><div class="page-sub">Fill rates per session and room booking efficiency</div></div>
        </div>
        <div id="capacity-content"></div>
    </div>
</main>

<script>
const charts = {};
const GRID = '#2a3040', TICK = '#8b949e';
const C = ['#e8a020','#2f9fd8','#3fb950','#f85149','#a371f7','#79c0ff','#f0883e','#56d364'];
const axNoX = { x:{ticks:{color:TICK},grid:{display:false}}, y:{ticks:{color:TICK},grid:{color:GRID}} };
const axPct  = { x:{ticks:{color:TICK},grid:{display:false}}, y:{max:100,ticks:{color:TICK,callback:v=>v+'%'},grid:{color:GRID}} };


const reportingData = {
    dashboardSummary:          @Html.Raw(Model.DashboardSummary),
    enrollmentTrends:          @Html.Raw(Model.EnrollmentTrends),
    enrollmentsByCategory:     @Html.Raw(Model.EnrollmentsByCategory),
    enrollmentsByCourse:       @Html.Raw(Model.EnrollmentsByCourse),
    enrollmentStatusBreakdown: @Html.Raw(Model.EnrollmentStatusBreakdown),
    instructorWorkload:        @Html.Raw(Model.InstructorWorkload),
    certificationData:         @Html.Raw(Model.CertificationData),
    revenueData:               @Html.Raw(Model.RevenueData),
    assessmentsByCourse:       @Html.Raw(Model.AssessmentsByCourse),
    assessmentsByInstructor:   @Html.Raw(Model.AssessmentsByInstructor),
    roomUtilization:           @Html.Raw(Model.RoomUtilization),
    lowEnrollmentSessions:     @Html.Raw(Model.LowEnrollmentSessions)
};

function fmt(n)       { return typeof n === 'number' ? n.toLocaleString() : (n ?? 0); }
function curr(n)      { return '$' + fmt(n); }
function trunc(s, l)  { return s && s.length > l ? s.substring(0, l) + '…' : s; }
function pctOf(a, b)  { return b > 0 ? Math.round((a / b) * 100) : 0; }
function badgePct(n)  { return `<span class="badge ${n>=80?'bg':n>=60?'ba':'br'}">${n}%</span>`; }
function pb(pct, cls='') { return `<div class="pb-wrap"><div class="pb-fill ${cls}" style="width:${Math.min(pct,100)}%"></div></div>`; }

function mc(label, val, color, delta) {
    const d = delta==='up'   ? `<div class="metric-delta up">&#8679; Trending up</div>`
            : delta==='down' ? `<div class="metric-delta down">&#8681; Needs attention</div>` : '';
    return `<div class="metric-card" style="--mc-color:${color}"><div class="metric-label">${label}</div><div class="metric-value">${val}</div>${d}</div>`;
}

function cw(id, h=200) { return `<div class="chart-wrap" style="height:${h}px"><canvas id="${id}"></canvas></div>`; }

function mkChart(id, config) {
    if (charts[id]) charts[id].destroy();
    const el = document.getElementById(id);
    if (el) charts[id] = new Chart(el, config);
}

function showPage(name, el) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById('page-' + name).classList.add('active');
    el.classList.add('active');
    const loaderFunc = { overview:loadOverview, enrollment:loadEnrollment, instructors:loadInstructors,
        certifications:loadCertifications, revenue:loadRevenue, assessments:loadAssessments, capacity:loadCapacity }[name];
    if (loaderFunc) loaderFunc();
}


function loadOverview() {
    const el = document.getElementById('overview-content');
    try {
        const d     = reportingData.dashboardSummary;
        const trend = reportingData.enrollmentTrends;
        const cat   = reportingData.enrollmentsByCategory;
        el.innerHTML = `
        <div class="metrics-grid">
            ${mc('Total Trainees',     fmt(d.totalTrainees),      '#2f9fd8')}
            ${mc('Instructors',         fmt(d.totalInstructors),   '#3fb950')}
            ${mc('Courses',             fmt(d.totalCourses),       '#e8a020')}
            ${mc('Active Sessions',     fmt(d.activeSessions),     '#a371f7')}
            ${mc('Pending Payments',    fmt(d.pendingPayments),    '#f85149','down')}
            ${mc('Certificates Issued', fmt(d.certificatesIssued), '#56d364','up')}
        </div>
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Monthly Enrollments</div><div class="chart-panel-sub">Full-year enrollment volume</div>${cw('ovTrend')}</div>
            <div class="chart-panel"><div class="chart-panel-title">Enrollments by Category</div><div class="chart-panel-sub">Distribution across subjects</div>${cw('ovCat')}</div>
        </div>`;
        setTimeout(() => {
            mkChart('ovTrend',{type:'line',data:{labels:trend.labels,datasets:[{label:'Enrollments',data:trend.data,borderColor:'#e8a020',backgroundColor:'rgba(232,160,32,.08)',tension:.4,fill:true,pointBackgroundColor:'#e8a020'}]},options:{responsive:true,maintainAspectRatio:false,scales:axNoX,plugins:{legend:{display:false}}}});
            mkChart('ovCat',  {type:'doughnut',data:{labels:cat.map(c=>c.category),datasets:[{data:cat.map(c=>c.count),backgroundColor:C,borderColor:'#161b22',borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:TICK,font:{size:11},boxWidth:12}}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading overview data — ${e.message}</div>`; }
}


function loadEnrollment() {
    const el = document.getElementById('enrollment-content');
    try {
        const courses = reportingData.enrollmentsByCourse;
        const status  = reportingData.enrollmentStatusBreakdown;
        const se      = Object.entries(status);
        const rows = courses.map(c=>`<tr><td>${c.course}</td><td class="td-m">${c.enrolled}</td><td>${c.completed}</td><td>${c.dropped}</td><td>${badgePct(pctOf(c.completed,c.enrolled))}</td></tr>`).join('');
        el.innerHTML = `
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Lifecycle Status</div><div class="chart-panel-sub">Count of trainees per status</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">${se.map(([k,v])=>`<span style="font-size:12px;color:var(--muted)"><span class="badge bgr">${k}</span> <strong style="color:var(--text)">${v}</strong></span>`).join('')}</div>
                ${cw('enrStatus',180)}</div>
            <div class="chart-panel"><div class="chart-panel-title">Completion Rate by Course</div><div class="chart-panel-sub">% trainees reaching COMPLETED</div>${cw('enrComp',courses.length*38+40)}</div>
        </div>
        <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Enrollment Detail by Course</div></div>
        <table><thead><tr><th>Course</th><th>Enrolled</th><th>Completed</th><th>Dropped</th><th>Completion Rate</th></tr></thead><tbody>${rows}</tbody></table></div>`;
        setTimeout(() => {
            mkChart('enrStatus',{type:'bar',data:{labels:se.map(([k])=>k),datasets:[{data:se.map(([,v])=>v),backgroundColor:['#2f9fd8','#e8a020','#a371f7','#3fb950','#f85149'],borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:axNoX,plugins:{legend:{display:false}}}});
            const pcts = courses.map(c=>pctOf(c.completed,c.enrolled));
            mkChart('enrComp',{type:'bar',data:{labels:courses.map(c=>trunc(c.course,14)),datasets:[{data:pcts,backgroundColor:pcts.map(p=>p>=80?'#3fb950':p>=60?'#e8a020':'#f85149'),borderRadius:4}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{max:100,ticks:{color:TICK,callback:v=>v+'%'},grid:{color:GRID}},y:{ticks:{color:TICK,font:{size:11}},grid:{display:false}}},plugins:{legend:{display:false}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading enrollment data — ${e.message}</div>`; }
}


function loadInstructors() {
    const el = document.getElementById('instructors-content');
    try {
        const data = reportingData.instructorWorkload;
        const rows = data.map(i=>`<tr><td><strong>${i.name}</strong></td><td>${i.sessions}</td><td>${i.hours}h</td><td>${i.trainees}</td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="flex:1;min-width:80px">${pb(i.utilization,i.utilization>=80?'g':'')}</div><span style="font-family:var(--mono);font-size:12px;color:var(--muted);width:32px">${i.utilization}%</span></div></td></tr>`).join('');
        el.innerHTML = `
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Sessions Per Instructor</div><div class="chart-panel-sub">Total scheduled sessions</div>${cw('iSess')}</div>
            <div class="chart-panel"><div class="chart-panel-title">Availability Utilization</div><div class="chart-panel-sub">Scheduled vs available hours (%)</div>${cw('iUtil')}</div>
        </div>
        <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Instructor Workload Detail</div></div>
        <table><thead><tr><th>Instructor</th><th>Sessions</th><th>Hours</th><th>Trainees</th><th>Utilization</th></tr></thead><tbody>${rows}</tbody></table></div>`;
        setTimeout(() => {
            mkChart('iSess',{type:'bar',data:{labels:data.map(i=>i.name.split(' ')[0]),datasets:[{data:data.map(i=>i.sessions),backgroundColor:'#2f9fd8',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:axNoX,plugins:{legend:{display:false}}}});
            mkChart('iUtil',{type:'bar',data:{labels:data.map(i=>i.name.split(' ')[0]),datasets:[{data:data.map(i=>i.utilization),backgroundColor:data.map(i=>i.utilization>=80?'#3fb950':'#e8a020'),borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:axPct,plugins:{legend:{display:false}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading instructor data — ${e.message}</div>`; }
}


function loadCertifications() {
    const el = document.getElementById('certifications-content');
    try {
        const data           = reportingData.certificationData;
        const totalEligible  = data.reduce((s,t) => s + t.eligible,  0);
        const totalCompleted = data.reduce((s,t) => s + t.completed, 0);
        const overallPct     = pctOf(totalCompleted, totalEligible);

        const rows = data.map(t => {
            const pct = pctOf(t.completed, t.eligible);
            return `<div class="cert-row">
                <div class="cert-name">${t.name}</div>
                <div class="cert-bar">
                    ${pb(pct, pct>=80?'g':pct>=50?'':'b')}
                    <div class="cert-bar-sub">${t.completed} of ${t.eligible} trainees</div>
                </div>
                <div class="cert-count"><strong>${t.completed}</strong> / ${t.eligible}</div>
                <div class="cert-pct">${pct}%</div>
            </div>`;
        }).join('');

        el.innerHTML = `
        <div class="metrics-grid">
            ${mc('Tracks',          fmt(data.length),    '#e8a020')}
            ${mc('Total Eligible',  fmt(totalEligible),  '#2f9fd8')}
            ${mc('Fully Completed', fmt(totalCompleted), '#3fb950','up')}
            ${mc('Overall Rate',    overallPct + '%',    '#a371f7')}
        </div>
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Completion Rate per Track</div><div class="chart-panel-sub">% of eligible trainees who finished all required courses</div>${cw('certBar', Math.max(data.length*40+40,200))}</div>
            <div class="chart-panel"><div class="chart-panel-title">Completed vs Remaining</div><div class="chart-panel-sub">Overall split across all tracks</div>${cw('certPie')}</div>
        </div>
        <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Track Progress Detail</div></div>
        <div style="padding:0 8px">${rows}</div></div>`;

        setTimeout(() => {
            const pcts = data.map(t => pctOf(t.completed, t.eligible));
            mkChart('certBar',{type:'bar',data:{labels:data.map(t=>trunc(t.name,18)),datasets:[{data:pcts,backgroundColor:pcts.map(p=>p>=80?'#3fb950':p>=50?'#e8a020':'#f85149'),borderRadius:4}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{max:100,ticks:{color:TICK,callback:v=>v+'%'},grid:{color:GRID}},y:{ticks:{color:TICK,font:{size:11}},grid:{display:false}}},plugins:{legend:{display:false}}}});
            mkChart('certPie',{type:'doughnut',data:{labels:['Completed','Not Completed'],datasets:[{data:[totalCompleted, totalEligible - totalCompleted],backgroundColor:['#3fb950','#30363d'],borderColor:'#161b22',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{color:TICK,font:{size:11},boxWidth:12}}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading certification data — ${e.message}</div>`; }
}


function loadRevenue() {
    const el = document.getElementById('revenue-content');
    try {
        const data       = reportingData.revenueData;
        const outstanding = data.outstanding ?? (data.totalRevenue - data.collected);
        const collRate    = pctOf(data.collected, data.totalRevenue);

        el.innerHTML = `
        <div class="metrics-grid">
            ${mc('Total Revenue',    curr(data.totalRevenue), '#e8a020')}
            ${mc('Collected',        curr(data.collected),    '#3fb950','up')}
            ${mc('Outstanding',      curr(outstanding),       '#f85149','down')}
            ${mc('Overdue Accounts', fmt(data.overdue),       '#e8a020','down')}
            ${mc('Collection Rate',  collRate + '%',          '#2f9fd8')}
        </div>
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Collected vs Outstanding</div><div class="chart-panel-sub">Overall revenue split</div>${cw('revPie')}</div>
            <div class="chart-panel"><div class="chart-panel-title">Collection Rate</div><div class="chart-panel-sub">Percentage of total revenue received</div>
                <div style="display:flex;flex-direction:column;justify-content:center;height:200px;gap:14px;padding:4px 0">
                    <div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:12px">
                            <span style="color:var(--muted)">Collected</span>
                            <span style="font-family:var(--mono)">${collRate}%</span>
                        </div>
                        <div class="pb-wrap" style="height:10px"><div class="pb-fill g" style="width:${collRate}%"></div></div>
                    </div>
                    <div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:5px;font-size:12px">
                            <span style="color:var(--muted)">Outstanding</span>
                            <span style="font-family:var(--mono)">${100-collRate}%</span>
                        </div>
                        <div class="pb-wrap" style="height:10px"><div class="pb-fill" style="width:${100-collRate}%;background:var(--danger)"></div></div>
                    </div>
                    <div style="margin-top:8px;padding:12px 14px;background:var(--surface2);border-radius:var(--r);border:1px solid var(--border)">
                        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px">Overdue Accounts</div>
                        <div style="font-size:26px;font-weight:700;font-family:var(--mono);color:var(--danger)">${fmt(data.overdue)}</div>
                    </div>
                </div>
            </div>
        </div>`;

        setTimeout(() => {
            mkChart('revPie',{type:'doughnut',data:{labels:['Collected','Outstanding'],datasets:[{data:[data.collected, outstanding],backgroundColor:['#3fb950','#f85149'],borderColor:'#161b22',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'60%',plugins:{legend:{position:'bottom',labels:{color:TICK,font:{size:11},boxWidth:12}}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading revenue data — ${e.message}</div>`; }
}


function loadAssessments() {
    const el = document.getElementById('assessments-content');
    try {
        const data  = reportingData.assessmentsByCourse;  
        const instr = reportingData.assessmentsByInstructor;
        const rows  = data.map(c=>`<tr><td><strong>${c.course}</strong></td><td>${c.pass}</td><td>${c.fail}</td><td>${c.pass+c.fail}</td><td>${badgePct(pctOf(c.pass,c.pass+c.fail))}</td></tr>`).join('');
        const iRows = instr.map(i=>`<tr><td><strong>${i.name}</strong></td><td>${badgePct(i.passRate)}</td></tr>`).join('');
        el.innerHTML = `
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Pass/Fail by Course</div><div class="chart-panel-sub">Assessment results per course</div>${cw('aCourse',data.length*35+40)}</div>
            <div class="chart-panel"><div class="chart-panel-title">Pass Rate by Instructor</div><div class="chart-panel-sub">Instructor pass rates (%)</div>${cw('aInstr')}</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
            <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Pass / Fail by Course</div></div>
            <table><thead><tr><th>Course</th><th>Pass</th><th>Fail</th><th>Total</th><th>Rate</th></tr></thead><tbody>${rows}</tbody></table></div>
            <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Pass Rate by Instructor</div></div>
            <table><thead><tr><th>Instructor</th><th>Pass Rate</th></tr></thead><tbody>${iRows}</tbody></table></div>
        </div>`;
        setTimeout(() => {
            mkChart('aCourse',{type:'bar',data:{labels:data.map(c=>trunc(c.course,12)),datasets:[{label:'Pass',data:data.map(c=>c.pass),backgroundColor:'#3fb950',borderRadius:0},{label:'Fail',data:data.map(c=>c.fail),backgroundColor:'#f85149',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:{x:{stacked:true,ticks:{color:TICK,font:{size:10}},grid:{display:false}},y:{stacked:true,ticks:{color:TICK},grid:{color:GRID}}},plugins:{legend:{position:'top',labels:{color:TICK,font:{size:11},boxWidth:12}}}}});
            mkChart('aInstr', {type:'bar',data:{labels:instr.map(i=>i.name.split(' ')[0]),datasets:[{data:instr.map(i=>i.passRate),backgroundColor:instr.map(i=>i.passRate>=80?'#3fb950':'#e8a020'),borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:axPct,plugins:{legend:{display:false}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading assessment data — ${e.message}</div>`; }
}


function loadCapacity() {
    const el = document.getElementById('capacity-content');
    try {
        const rooms = reportingData.roomUtilization;
        const low   = reportingData.lowEnrollmentSessions;
        const roomRows = rooms.map(r=>`<tr><td><strong>${r.room}</strong></td><td>${r.booked}</td><td>${r.totalSlots}</td>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="flex:1;min-width:60px">${pb(r.fillRate,r.fillRate>=80?'g':'')}</div>${badgePct(r.fillRate)}</div></td></tr>`).join('');
        const lowRows = low.map(s=>{const p=pctOf(s.enrolled,s.capacity);return`<tr><td><strong>${s.course}</strong></td><td class="td-m">${s.room}</td><td class="td-m">${s.date}</td><td>${s.enrolled} / ${s.capacity}</td><td>${badgePct(p)}</td></tr>`;}).join('');
        el.innerHTML = `
        <div class="charts-row">
            <div class="chart-panel"><div class="chart-panel-title">Room Booking Utilization</div><div class="chart-panel-sub">Booked sessions vs total available slots</div>${cw('roomC',220)}</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
            <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Room Utilization Detail</div></div>
            <table><thead><tr><th>Room</th><th>Booked</th><th>Total Slots</th><th>Fill Rate</th></tr></thead><tbody>${roomRows}</tbody></table></div>
            <div class="table-panel"><div class="table-panel-header"><div class="table-panel-title">Low Enrollment Sessions</div><span class="badge ba">Action needed</span></div>
            <table><thead><tr><th>Course</th><th>Room</th><th>Date</th><th>Enrollment</th><th>Rate</th></tr></thead><tbody>${lowRows}</tbody></table></div>
        </div>`;
        setTimeout(() => {
            mkChart('roomC',{type:'bar',data:{labels:rooms.map(r=>r.room),datasets:[{data:rooms.map(r=>r.fillRate),backgroundColor:rooms.map(r=>r.fillRate>=80?'#3fb950':r.fillRate>=60?'#e8a020':'#f85149'),borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:{x:{ticks:{color:TICK},grid:{display:false}},y:{max:100,ticks:{color:TICK,callback:v=>v+'%'},grid:{color:GRID}}},plugins:{legend:{display:false}}}});
        },0);
    } catch(e) { el.innerHTML = `<div class="error-box">Error loading capacity data — ${e.message}</div>`; }
}

loadOverview();
</script>
</body>
</html>
