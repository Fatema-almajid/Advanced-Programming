@model MVC_Application.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- Page header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-speedometer2"></i> Dashboard
            </h2>
            <p class="text-muted mb-0">
                Overview of trainees, courses, schedules, payments, and certifications.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-journal-text"></i> Courses
            </a>
            <a asp-controller="Schedules" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-calendar-event"></i> Schedules
            </a>
            <a asp-controller="Enrollments" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-people"></i> Manage Enrollments
            </a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Trainees</p>
                            <h3 class="mb-0">@Model.TotalTrainees</h3>
                        </div>
                        <i class="bi bi-person-badge fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Instructors</p>
                            <h3 class="mb-0">@Model.TotalInstructors</h3>
                        </div>
                        <i class="bi bi-mortarboard fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Courses</p>
                            <h3 class="mb-0">@Model.TotalCourses</h3>
                        </div>
                        <i class="bi bi-book fs-2 text-info"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Active Schedules</p>
                            <h3 class="mb-0">@Model.ActiveSchedules</h3>
                        </div>
                        <i class="bi bi-calendar-check fs-2 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Pending Payments</p>
                            <h3 class="mb-0">@Model.PendingPayments</h3>
                        </div>
                        <i class="bi bi-credit-card fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Certificates Issued</p>
                            <h3 class="mb-0">@Model.CertificatesIssued</h3>
                        </div>
                        <i class="bi bi-patch-check fs-2 text-secondary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 justify-content-center mb-4">
        <div class="col-12">
            <div class="card shadow-sm dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-event"></i> Upcoming Courses
                    </h5>
                    <a asp-controller="Schedules" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>

                <div class="card-body">
                    @if (Model.UpcomingCourses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Course</th>
                                        <th>Instructor</th>
                                        <th>Room</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Capacity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UpcomingCourses)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.CourseName</td>
                                            <td>@item.InstructorName</td>
                                            <td>@item.RoomName</td>
                                            <td>@item.ScheduleDate</td>
                                            <td>@item.ScheduleTime</td>
                                            <td>
                                                <span class="badge @(item.EnrolledCount >= item.Capacity ? "bg-danger" : item.EnrolledCount >= item.Capacity - 5 ? "bg-warning text-dark" : "bg-success")">
                                                    @item.EnrolledCount / @item.Capacity
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No upcoming courses found.</p>
                    }
                </div>
            </div>
        </div>
    

     
        <!-- Recent enrollments -->
        <div class="col-lg-7">
            <div class="card shadow-sm dashboard-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people-fill"></i> Recent Enrollments
                    </h5>
                    <a asp-controller="Enrollments" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>

                <div class="card-body">
                    @if (Model.RecentEnrollments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var enrollment in Model.RecentEnrollments)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold">@enrollment.TraineeName</div>
                                            <div class="text-muted small">@enrollment.CourseName</div>
                                        </div>

                                        <div class="text-end">
                                            <span class="badge @(enrollment.Status == "Confirmed" ? "bg-success" :
                                                                                                                   enrollment.Status == "Enrolled" ? "bg-primary" :
                                                                                                                   enrollment.Status == "Attending" ? "bg-info text-dark" :
                                                                                                                   "bg-secondary")">
                                        @enrollment.Status
                                    </span>
                                    <div class="small text-muted mt-1">@enrollment.EnrolledDate</div>
                                </div>
                            </div>
                        </div>
                                                }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recent enrollments found.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="col-lg-5">
        <div class="card shadow-sm dashboard-card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-charge"></i> Quick Actions
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <a asp-controller="Courses" asp-action="Create" class="btn btn-outline-primary w-100 p-3">
                                <i class="bi bi-journal-plus d-block fs-4 mb-2"></i>
                                Add Course
                            </a>
                        </div>

                        <div class="col-6">
                            <a asp-controller="Instructors" asp-action="Create" class="btn btn-outline-success w-100 p-3">
                                <i class="bi bi-person-plus d-block fs-4 mb-2"></i>
                                Add Instructor
                            </a>
                        </div>

                        <div class="col-6">
                            <a asp-controller="Schedules" asp-action="Create" class="btn btn-outline-warning w-100 p-3">
                                <i class="bi bi-calendar-plus d-block fs-4 mb-2"></i>
                                Schedule Course
                            </a>
                        </div>

                        <div class="col-6">
                            <a asp-controller="Payments" asp-action="Index" class="btn btn-outline-danger w-100 p-3">
                                <i class="bi bi-cash-coin d-block fs-4 mb-2"></i>
                                View Payments
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>