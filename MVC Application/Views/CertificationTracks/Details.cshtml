@model TrainingCertificationPlatform.Models.Track

@{
    ViewData["Title"] = "Certification Track Details";
}

<partial name="_TrainingCoordinatorNav" />

<div class="card shadow-sm">
    <div class="card-body">
        <span class="badge bg-primary mb-3">
            Certification Track
        </span>

        <h2>
            <i class="bi bi-award"></i> @Model.Name
        </h2>

        <p class="text-muted">
            @Model.Description
        </p>

        <hr />

        <h5 class="mb-3">
            Required Courses
        </h5>

        @if (Model.Courses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Title</th>
                            <th>Category</th>
                            <th>Duration</th>
                            <th>Fee</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td class="fw-semibold">@course.Title</td>
                                <td>@course.Category</td>
                                <td>@course.Duration hrs</td>
                                <td>@course.Fee.ToString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">
                No required courses assigned.
            </p>
        }
    </div>

    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>