@model TrainingCertificationPlatform.Models.Track

@{
    ViewData["Title"] = "Delete Certification Track";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">
            <i class="bi bi-trash"></i> Delete Certification Track
        </h4>
    </div>

    <div class="card-body">
        <h5>
            Are you sure you want to delete
            <strong>@Model.Name</strong>?
        </h5>

        <p class="text-muted">
            This will delete the certification track and remove its required-course mappings.
        </p>

        <hr />

        <h6>Courses inside this track:</h6>

        @if (Model.Courses.Any())
        {
            <ul class="list-group mb-4">
                @foreach (var course in Model.Courses)
                {
                    <li class="list-group-item">
                        <i class="bi bi-journal-bookmark"></i>
                        @course.Title
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">
                This track has no courses.
            </p>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>