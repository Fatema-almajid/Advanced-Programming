@* 
 * This Razor View implements a strongly-typed public interface (`CertificationLookupViewModel`) for user-driven record verification.
 * It employs standard ASP.NET Core Tag Helpers (`asp-for`) to map input data elements directly to model state properties,
 * executing server-side conditional rendering structures (`@if`) to dynamically display contextual validation error feedback or verification results.
 * The presentation layer implements structured evaluation pathways to safely navigate and unwrap internal metadata collection arrays (`@foreach`),
 * rendering asynchronous domain payload attributes alongside dynamic system timestamp operations (`DateTime.Now`), all structured inside responsive and stylized UI components.
 *@
 
 @model MVC_Application.Models.ViewModels.CertificationLookupViewModel

@{
    ViewData["Title"] = "Public Certification Lookup";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h2 class="text-center mb-4">
                    Certification Verification
                </h2>

                <form method="post">

                    <div class="mb-3">
                        <label class="form-label">CPR</label>
                        <input asp-for="CPR" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Certificate Reference Number
                        </label>
                        <input asp-for="ReferenceNumber" class="form-control" />
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary">
                            Verify Certification
                        </button>
                    </div>

                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-4">
                        @ViewBag.Error
                    </div>
                }

                @if (Model.TraineeName != null)
                {
                    <div class="card mt-4 border-0 shadow-lg rounded-4">
                        <div class="card-body">

                            <div class="text-center mb-4">

                                <i class="bi bi-patch-check-fill text-success"
                                   style="font-size:70px;">
                                </i>

                                <h3 class="fw-bold text-success mt-3">
                                    Certification Verified
                                </h3>

                                <p class="text-muted">
                                    This certification has been successfully verified.
                                </p>

                            </div>

                            <p>
                                <strong>Trainee:</strong>
                                @Model.TraineeName
                            </p>

                            <p>
                                <strong>Track:</strong>
                                @Model.Track
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (Model.Status == "SUCCESS")
                                {
                                    <span class="badge bg-success">
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Failed
                                    </span>
                                }
                            </p>

                            <p>
                                <strong>Certificate Reference:</strong>
                                @Model.CertificateReference
                            </p>

                            <p>
                                <strong>Verified On:</strong>
                                @Model.VerificationDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Total Completed Courses:</strong>
                                @Model.TotalCompletedCourses
                            </p>

                            <p>
                                <strong>Reference Number:</strong>
                                @Model.ReferenceNumber
                            </p>

                            <p>
                                <strong>Verified On:</strong>
                                @DateTime.Now.ToString("dd MMM yyyy")
                            </p>

                            <h5 class="mt-4">
                                Completed Courses
                            </h5>

                            <ul class="list-group">
                                @foreach (var course in Model.CompletedCourses)
                                {
                                    <li class="list-group-item d-flex align-items-center">

                                        <i class="bi bi-check-circle-fill text-success me-2"></i>

                                        @course

                                    </li>
                                }
                            </ul>


                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>