@using System.Security.Claims

<nav class="navbar navbar-expand-lg navbar-light bg-white border rounded shadow-sm mb-4 px-3">
    <div class="container-fluid">

        <span class="navbar-brand fw-semibold">
            <i class="bi bi-person-circle"></i>
            @User.FindFirst(ClaimTypes.Name)?.Value
        </span>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            <div class="navbar-nav mx-auto flex-wrap">

                <a class="nav-link" asp-controller="TrainingCoordinator" asp-action="Dashboard">
                    Dashboard
                </a>

                <a class="nav-link" asp-controller="Courses" asp-action="Index">
                    Course Catalog
                </a>

                <a class="nav-link" asp-controller="Sessions" asp-action="Index">
                    Sessions
                </a>

                <a class="nav-link" asp-controller="Classrooms" asp-action="Index">
                    Classrooms
                </a>

                <a class="nav-link"
                   asp-controller="CertificationTracks"
                   asp-action="Index">
                    Tracks
                </a>

                <a class="nav-link" asp-controller="Instructors" asp-action="Index">
                    Instructors
                </a>

                <a class="nav-link" asp-controller="Payments" asp-action="Index">
                    Payment
                </a>
            </div>

            <div class="navbar-nav">
                <a class="nav-link text-danger"
                   asp-controller="Account"
                   asp-action="Logout">
                    Logout
                </a>
            </div>

        </div>
    </div>
</nav>