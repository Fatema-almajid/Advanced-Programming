@model IEnumerable<MVC_Application.Models.ViewModels.InstructorListItemViewModel>

@{
    ViewData["Title"] = "Instructor Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="bi bi-person-workspace"></i> Instructor Management
    </h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Instructor
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-9">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by name, email, phone, or expertise..." />
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary w-100">
            Clear
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Registration Date</th>
                <th>Availability</th>
                <th>Expertise</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.RegistrationDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Availability</td>
                        <td>
                            @(item.ExpertiseCourses.Length > 45
                                                ? item.ExpertiseCourses.Substring(0, 45) + "..."
                                                : item.ExpertiseCourses)
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
                        }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No instructors found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>