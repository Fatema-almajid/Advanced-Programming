@model TrainingCertificationPlatform.Models.User
@using TrainingCertificationPlatform.Models

@{
    ViewData["Title"] = "Delete Instructor";
    var availability = ViewBag.Availability as InstructorAvailability;
    var expertiseCourses = ViewBag.ExpertiseCourses as List<string> ?? new List<string>();
}

<h2 class="mb-4 text-danger">
    <i class="bi bi-trash"></i> Delete Instructor
</h2>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <p class="fs-5">Are you sure you want to delete this instructor?</p>

        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Registration Date</dt>
            <dd class="col-sm-9">@Model.RegistrationDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Availability</dt>
            <dd class="col-sm-9">@(availability == null ? "Not set" : $"{availability.DayStart} - {availability.DayEnd} | {availability.StartTime} - {availability.EndTime}")</dd>

            <dt class="col-sm-3">Expertise</dt>
            <dd class="col-sm-9">@(expertiseCourses.Any() ? string.Join(", ", expertiseCourses) : "None")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this instructor?');">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>