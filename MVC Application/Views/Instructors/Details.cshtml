@model TrainingCertificationPlatform.Models.User
@using TrainingCertificationPlatform.Models

@{
    ViewData["Title"] = "Instructor Details";
    var availability = ViewBag.Availability as InstructorAvailability;
    var expertiseCourses = ViewBag.ExpertiseCourses as List<string> ?? new List<string>();
}

<partial name="_TrainingCoordinatorNav" />

<h2 class="mb-4">
    <i class="bi bi-eye"></i> Instructor Details
</h2>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="mb-3">@Model.FirstName @Model.LastName</h4>

                <p class="text-muted mb-1">@Model.Email</p>
                <p class="text-muted">@Model.Phone</p>

                <hr />

                <dl class="row">
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Role</span></dd>

                    <dt class="col-sm-4">Registration Date</dt>
                    <dd class="col-sm-8">@Model.RegistrationDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Availability Days</dt>
                    <dd class="col-sm-8">@(availability == null ? "Not set" : $"{availability.DayStart} - {availability.DayEnd}")</dd>

                    <dt class="col-sm-4">Availability Time</dt>
                    <dd class="col-sm-8">@(availability == null ? "Not set" : $"{availability.StartTime} - {availability.EndTime}")</dd>

                    <dt class="col-sm-4">Expertise Courses</dt>
                    <dd class="col-sm-8">@(expertiseCourses.Any() ? string.Join(", ", expertiseCourses) : "None")</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>