@model IEnumerable<TrainingCertificationPlatform.Models.Payment>

@{
    ViewData["Title"] = "Payment Tracking";
}
@if (ViewBag.Role == "Instructor")
{
    <partial name="~/Views/Instructor/_InstructorNav.cshtml" />
}
else if (ViewBag.Role == "TrainingCoordinator")
{
    <partial name="_TrainingCoordinatorNav" />
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="bi-credit-card"></i> Payment Tracking
    </h2>

    @if (ViewBag.Role == "TrainingCoordinator")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Record Payment
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Trainee</th>
                <th>Course</th>
                <th>Amount Paid</th>
                <th>Payment Status</th>
                <th>Payment Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var payment in Model)
                {
                    <tr>
                        <td>@payment.Enrollment.Trainee.FirstName @payment.Enrollment.Trainee.LastName</td>
                        <td class="fw-semibold">@payment.Enrollment.Session.Course.Title</td>
                        <td>BHD @payment.Amount</td>
                        <td>@payment.Status</td>
                        <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                    </tr>    
                }

            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No payments found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>