@using TrainingCertificationPlatform.Models

@{
    ViewData["Title"] = "Record Payment";
    var courses = ViewBag.Courses as List<Course>;
    var enrollments = ViewBag.Enrollments as List<Enrollment>;
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
    int? selectedEnrollmentId = ViewBag.SelectedEnrollmentId as int?;
}


<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="bi-credit-card"></i> Record Payment
    </h2>

    @{
        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    }

    @if (role == "TRAINEE")
    {
        <a asp-controller="Trainee"
               asp-action="MyPayments"
               class="btn btn-outline-secondary">
            Back to My Payments
        </a>
    }
    else if (role == "ADMIN" || role == "COORDINATOR")
    {
        <a asp-controller="Payments"
               asp-action="Index"
               class="btn btn-outline-secondary">
            Back to Payments
        </a>
    }

</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" method="post" class="card p-4 shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="m-3">
        <label class="form-label">Course</label>

        <select name="courseId"
                class="form-select"
                required
                onchange="window.location.href='@Url.Action("Create", "Payments")?courseId=' + this.value">

            <option value="">Select Course</option>

            @if (courses != null)
            {
                foreach (var course in courses)
                {
                    <option value="@course.Id" selected="@(selectedCourseId == course.Id)">
                        @course.Title
                    </option>
                }
            }
        </select>
    </div>
    <div class="m-3">
        <label class="form-label">Enrollment</label>

        <select name="enrollmentId" class="form-select" required>
            <option value="">Select Enrollment</option>

            @if (selectedCourseId == null)
            {
                <option disabled>Please select a course first</option>
            }
            else if (enrollments != null && enrollments.Any())
            {
                foreach (var enrollment in enrollments)
                {
                    <option value="@enrollment.Id" selected="@(selectedEnrollmentId == enrollment.Id)">
                        @enrollment.Trainee.FirstName @enrollment.Trainee.LastName
                        - Due: BHD @enrollment.Balance?.AmountDue
                    </option>
                }
            }
            else
            {
                <option disabled>No trainees need payment for this course</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Amount</label>
        <input type="number" name="amount" class="form-control" step="1" min="1" required />
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle"></i> Record Payment
    </button>
</form>