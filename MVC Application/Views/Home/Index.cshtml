@{
    ViewData["Title"] = "Home Page";
}

<div class="container d-flex justify-content-center align-items-center"
     style="min-height: 80vh;">

    <div class="text-center p-5 rounded-4 shadow-sm bg-white"
         style="max-width: 800px; width:100%;">

        <h1 class="display-4 mb-4 fw-light">
            Welcome
        </h1>

        <h2 class="fw-semibold mb-3">
            Training & Certification Platform
        </h2>

        <p class="lead text-muted mb-5">
            Manage courses, instructors, rooms, scheduling,
            certifications, and trainee progress.
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary px-4 py-2 rounded-pill">
                Login
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-primary px-4 py-2 rounded-pill">
                Register
            </a>

            <a asp-controller="PublicCertification"
               asp-action="Index"
               class="btn btn-primary px-4 py-2 rounded-pill">
                Certification Lookup
            </a>

        </div>

    </div>

</div>