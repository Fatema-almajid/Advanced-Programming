@model IEnumerable<TrainingCertificationPlatform.Models.Course>

@{
    ViewData["Title"] = "Courses Catalog";
}

<partial name="_TrainingCoordinatorNav" />

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="bi bi-journal-bookmark"></i> Courses Catalog
    </h2>

    <div class="d-flex gap-2">
        <a asp-action="Index"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-categoryFilter="@ViewData["CurrentCategory"]"
           class="btn btn-outline-secondary">
            <i class="bi bi-table"></i> Table View
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Course
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="CardIndex" method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by title, description, or prerequisite..." />
    </div>

    <div class="col-md-4">
        <select name="categoryFilter" asp-items="ViewBag.CategoryFilterList" class="form-select"></select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-action="CardIndex" class="btn btn-outline-secondary w-100">
            Clear
        </a>
    </div>
</form>

<div class="row">
    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm course-card">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text text-muted">
                            @(item.Description.Length > 100
                                                ? item.Description.Substring(0, 100) + "..."
                                                : item.Description)
                </p>

                        <div class="mb-2">
                            <span class="badge bg-primary">@item.Category</span>
                            <span class="badge bg-secondary">Capacity: @item.Capacity</span>
                        </div>

                        <ul class="list-unstyled small mb-0">
                            <li><strong>Duration:</strong> @item.Duration hours</li>
                            <li><strong>Fee:</strong> @item.Fee.ToString()</li>
                            <li><strong>Prerequisite:</strong> @(item.Prerequisite?.Title ?? "None")</li>
                        </ul>
                    </div>

                    <div class="card-footer text-center d-flex justify-content-center gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i> Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-light border text-center text-muted">
                No courses found.
            </div>
        </div>
    }
</div>