@model IEnumerable<TrainingCertificationPlatform.Models.Course>

@{
    ViewData["Title"] = "Courses Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="bi bi-journal-bookmark"></i> Courses Management
    </h2>

    <div class="d-flex gap-2">
        <a asp-action="CardIndex"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-categoryFilter="@ViewData["CurrentCategory"]"
           class="btn btn-outline-secondary">
            <i class="bi bi-grid-3x3-gap"></i> Card View
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Course
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by title, description, or prerequisite..." />
    </div>

    <div class="col-md-4">
        <select name="categoryFilter" asp-items="ViewBag.CategoryFilterList" class="form-select"></select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary w-100">
            Clear
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Description</th>
                <th>Duration</th>
                <th>Capacity</th>
                <th>Fee</th>
                <th>Prerequisite</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>
                            <span class="badge bg-primary">@item.Category</span>
                        </td>
                        <td>
                            @(item.Description.Length > 70
                                                ? item.Description.Substring(0, 70) + "..."
                                                : item.Description)
                </td>
                <td>@item.Duration hrs</td>
                <td>@item.Capacity</td>
                <td>@item.Fee.ToString("C")</td>
                <td>@(item.Prerequisite?.Title ?? "None")</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i>
                        </a>

                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                        }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No courses found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>