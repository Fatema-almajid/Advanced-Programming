@model MVC_Application.Models.ViewModels.SessionFormViewModel

@{
    ViewData["Title"] = "Create Session";
}

<h2 class="mb-4">
    <i class="bi bi-plus-circle"></i> Create Session
</h2>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label"></label>
                        <select asp-for="CourseId" asp-items="ViewBag.CourseList" class="form-select">
                            <option value="">Select a course</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InstructorId" class="form-label"></label>
                        <select asp-for="InstructorId" asp-items="ViewBag.InstructorList" class="form-select">
                            <option value="">Select an instructor</option>
                        </select>
                        <span asp-validation-for="InstructorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClassroomId" class="form-label"></label>
                        <select asp-for="ClassroomId" asp-items="ViewBag.ClassroomList" class="form-select">
                            <option value="">Select a room</option>
                        </select>
                        <span asp-validation-for="ClassroomId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SessionDate" class="form-label"></label>
                        <input asp-for="SessionDate" class="form-control" />
                        <span asp-validation-for="SessionDate" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}