@model List<MVC_Application.Models.ViewModels.TraineeCourseViewModel>

@{
    ViewData["Title"] = "My Courses";

    var chances = 3; // default chances
}

<partial name="_TraineeNav" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-journal-bookmark"></i> My Courses
    </h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You are not enrolled in any courses yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
           var remainingChances = chances - course.DroppedCount;

            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100
                    @(course.Status == "DROPPED" ? "border-danger opacity-75" : "")">

                    <div class="card-body d-flex flex-column">

                        <span class="course-category">
                            @course.Category
                        </span>

                        <h5 class="mt-3">
                            @course.Title
                        </h5>

                        <p class="text-muted">
                            @course.Description
                        </p>

                        <div class="mt-auto">

                            <div class="mb-2">

                                @if (course.Status == "ENROLLED")
                                {
                                    <span class="badge bg-secondary">
                                        Enrolled
                                    </span>
                                }
                                else if (course.Status == "CONFIRMED")
                                {
                                    <span class="badge bg-primary">
                                        Confirmed
                                    </span>
                                }
                                else if (course.Status == "ATTENDING")
                                {
                                    <span class="badge bg-info text-dark">
                                        Attending
                                    </span>
                                }
                                else if (course.Status == "COMPLETED")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else if (course.Status == "DROPPED")
                                {
                                    <span class="badge bg-danger">
                                        Dropped
                                    </span>
                                }

                            </div>

                            @if (course.Status == "DROPPED")
                            {
                                <button class="btn btn-secondary w-100 mb-2" disabled>
                                    Course Dropped
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Trainee"
                                   asp-action="CourseDetails"
                                   asp-route-id="@course.CourseId"
                                   class="btn btn-outline-primary w-100 mb-2">

                                    View Course
                                </a>
                            }

                            @* FEEDBACK BUTTON *@
                            @if (course.Status == "COMPLETED")
                            {
                                @* if user has already given feedback for this course, disable the button and show "Feedback Submitted" instead of "Give Feedback" *@
                                if (course.HasFeedback)
                                {
                                    <button class="btn btn-success w-100 mb-2" disabled>
                                        <i class="bi bi-check-lg"></i>
                                        Feedback Submitted
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="SubmitFeedback"
                                   asp-route-courseId="@course.CourseId"
                                   class="btn btn-warning w-100 mb-2">

                                    <i class="bi bi-star-fill"></i>
                                    Give Feedback
                                    </a>
                                }
                                
                            }

                            @if (course.Status != "DROPPED"
                                                && course.Status != "COMPLETED")
                            {
                                <form asp-action="DropCourse"
                                class="drop-course-form"
                                data-remaining-chances="@remainingChances"
                                      method="post">

                                    <input type="hidden"
                                           name="enrollmentId"
                                           value="@course.EnrollmentId" />

                                    <button type="submit"
                                            class="btn btn-danger w-100">

                                        <i class="bi bi-x-circle"></i>
                                        Drop Course

                                    </button>
                                </form>
                            }

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // Double check before dropping a course
        document.querySelectorAll(".drop-course-form").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    const remainingChances = form.dataset.remainingChances;

                    const confirmed = confirm(
                        "Are you sure you want to drop this course? Remaining chances: " + remainingChances
                    );

                    if (!confirmed) {
                        e.preventDefault();
                    }
                });
            });
    </script>
}
