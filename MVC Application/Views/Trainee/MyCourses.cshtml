@model IEnumerable<MVC_Application.Models.ViewModels.TraineeCourseViewModel>

@{
    ViewData["Title"] = "My Courses";
    var viewMode = ViewData["ViewMode"]?.ToString() ?? "card";
}

<partial name="_TraineeNav" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">My Courses</h2>

    <div class="d-flex gap-2">
        <a asp-action="MyCourses" asp-route-viewMode="card" class="btn btn-outline-secondary">
            <i class="bi bi-grid-3x3-gap"></i>
        </a>
        <a asp-action="MyCourses" asp-route-viewMode="table" class="btn btn-outline-secondary">
            <i class="bi bi-table"></i>
        </a>
    </div>
</div>

<form asp-action="MyCourses" method="get" class="row g-2 mb-4">
    <input type="hidden" name="viewMode" value="@viewMode" />

    <div class="col-md-5">
        <input name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search courses..." />
    </div>

    <div class="col-md-4">
        <select name="statusFilter" asp-items="ViewBag.StatusList" class="form-select">
            <option value="">All Statuses</option>
        </select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-outline-primary w-100">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-action="MyCourses" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

@if (viewMode == "table")
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Session</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td class="fw-semibold">@course.Title</td>
                        <td>@course.Category</td>
                        <td><span class="badge bg-primary">@course.Status</span></td>
                        <td>@course.SessionDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="CourseDetails" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View Course
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm course-card">
                    <div class="card-body">
                        <h5 class="card-title">@course.Title</h5>

                        <p class="card-text text-muted">
                            @(course.Description.Length > 100
                                                ? course.Description.Substring(0, 100) + "..."
                                                : course.Description)
                </p>

                        <div class="mb-2">
                            <span class="badge bg-primary">@course.Category</span>
                            <span class="badge bg-secondary">@course.Status</span>
                        </div>

                        <ul class="list-unstyled small mb-0">
                            <li><strong>Session:</strong> @course.SessionDate.ToString("dd MMM yyyy")</li>
                            <li><strong>Time:</strong> @course.StartTime - @course.EndTime</li>
                        </ul>
                    </div>

                    <div class="card-footer text-center">
                        <a asp-action="CourseDetails"
                           asp-route-id="@course.CourseId"
                           class="btn btn-info w-100 fw-semibold">
                            <i class="bi bi-eye"></i> View Course
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}