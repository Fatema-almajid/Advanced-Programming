@model List<MVC_Application.Models.ViewModels.TraineeCourseViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<partial name="_TraineeNav" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-journal-bookmark"></i> My Courses
    </h2>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You are not enrolled in any courses yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <span class="course-category">
                            @course.Category
                        </span>

                        <h5 class="mt-3">
                            @course.Title
                        </h5>

                        <p class="text-muted">
                            @course.Description
                        </p>

                        <div class="mt-auto">
                            <a asp-controller="Trainee"
                                   asp-action="CourseDetails"
                                   asp-route-id="@course.CourseId"
                                   class="view-course-btn">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}