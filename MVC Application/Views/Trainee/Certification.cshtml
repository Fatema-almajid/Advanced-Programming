@model IEnumerable<MVC_Application.Models.ViewModels.TraineeCertificationProgressViewModel>

@{
    ViewData["Title"] = "Certification";
}

<partial name="_TraineeNav" />

<h2 class="page-title">Certification Progress</h2>

<div class="row">
    @foreach (var track in Model)
    {
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@track.TrackName</h4>
                            <p class="text-muted">@track.Description</p>
                        </div>

                        @if (track.IsEligible)
                        {
                            <span class="badge bg-success align-self-start">Eligible</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark align-self-start">In Progress</span>
                        }
                    </div>

                    <div class="progress mb-3" style="height: 12px;">
                        <div class="progress-bar" style="width:@track.ProgressPercent%">
                            @track.ProgressPercent%
                        </div>
                    </div>

                    <p>
                        Completed @track.CompletedCourses of @track.RequiredCourses courses.
                        @track.RemainingCourses courses left.
                    </p>

                    <ul class="list-group list-group-flush">
                        @foreach (var course in track.Courses)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                @course.CourseTitle

                                @if (course.IsCompleted)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle"></i> Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="bi bi-clock"></i> Remaining
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (track.IsEligible)
                    {
                        <button class="view-course-btn mt-3">
                            <i class="bi bi-award"></i> Generate Certificate
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>