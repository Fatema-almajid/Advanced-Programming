@model IEnumerable<MVC_Application.Models.ViewModels.TraineeCertificationProgressViewModel>

@{
    ViewData["Title"] = "Certification";
}

<partial name="_TraineeNav" />

<h2 class="page-title">Certification Progress</h2>

<div class="row">
    @foreach (var track in Model)
    {
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@track.TrackName</h4>
                            <p class="text-muted">@track.Description</p>
                        </div>

                        @if (track.IsEligible)
                        {
                            <span class="badge bg-success align-self-start">Eligible</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark align-self-start">In Progress</span>
                        }
                    </div>

                    <div class="progress mb-3" style="height: 20px; border-radius: 10px;">
                        <div class="progress-bar" style="width:@track.ProgressPercent%">
                            @track.ProgressPercent%
                        </div>
                    </div>

                    <p>
                        Completed @track.CompletedCourses of @track.RequiredCourses courses.
                        @track.RemainingCourses courses left.
                    </p>

                    <ul class="list-group list-group-flush">
                        @foreach (var course in track.Courses)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                @course.CourseTitle

                                @if (course.IsCompleted)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle"></i> Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="bi bi-clock"></i> Remaining
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (track.IsEligible)
                    {
                        <form asp-action="GenerateCertificate" method="post">

                            <input type="hidden"
                                   name="trackId"
                                   value="@track.TrackId" />

                            <button type="submit"
                                    class="btn btn-outline-dark mt-3">

                                <i class="bi bi-award"></i>
                                Generate Certificate

                            </button>

                        </form>
                    }
                    <div class="modal fade"
                         id="certificateModal-@track.TrackId"
                         tabindex="-1"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-lg">

                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        <i class="bi bi-award"></i> Certificate
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body text-center p-5">
                                    <i class="bi bi-patch-check-fill text-success display-3"></i>

                                    <h2 class="mt-3">Congratulations!</h2>

                                    <p class="lead mb-1">
                                        You completed
                                    </p>

                                    <h4 class="fw-bold">
                                        @track.TrackName
                                    </h4>

                                    <hr />

                                    <p class="text-muted mb-0">
                                        Date: @DateTime.Today.ToString("dd MMMM yyyy")
                                    </p>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>