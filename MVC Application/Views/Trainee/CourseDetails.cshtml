@model TrainingCertificationPlatform.Models.Course

@{
    ViewData["Title"] = "Course Details";
    var session = ViewBag.NextSession as TrainingCertificationPlatform.Models.Session;
    bool isEnrolled = ViewBag.IsEnrolled;

    int enrolledCount = ViewBag.EnrolledCount ?? 0;
    int remainingSeats = Model.Capacity - enrolledCount;
}

<partial name="_TraineeNav" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@* data-course-id="@Model.Id" this is to have the trainee join the course group for real-time updates for enrollment count *@
<div class="card shadow-sm" data-course-id="@Model.Id">
    <div class="card-body p-4">
        <span class="course-category">@Model.Category</span>
        <h2 class="mt-3">@Model.Title</h2>

        <p class="text-muted">@Model.Description</p>

        <div class="table-responsive mt-4">
            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Duration</th>
                        <th>Capacity</th>
                        <th>Fee</th>
                        <th>Prerequisite</th>

                        @if (session != null)
                        {
                            <th>Session Date</th>
                            <th>Time</th>
                            <th>Instructor</th>
                            <th>Room</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    <tr>

                        <td class="fw-semibold">
                            @Model.Duration hrs
                        </td>

                        <td>
                            <div class="fw-semibold">
                                <span data-enrolled-count-for="@Model.Id">
                                    @enrolledCount
                                </span>
                                /
                                @Model.Capacity
                            </div>

                            @if (remainingSeats <= 0)
                            {
                                <span class="badge bg-danger mt-1">
                                    Full
                                </span>
                            }
                            else if (remainingSeats <= 5)
                            {
                                <span class="badge bg-warning text-dark mt-1">
                                    Almost Full
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success mt-1">
                                    Available
                                </span>
                            }
                        </td>

                        <td class="fw-semibold">
                            @Model.Fee.ToString("0.00") BHD
                        </td>

                        <td>
                            @(Model.Prerequisite?.Title ?? "None")
                        </td>

                        @if (session != null)
                        {
                            <td>
                                @session.SessionDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @session.StartTime.ToString("HH:mm")
                                -
                                @session.EndTime.ToString("HH:mm")
                            </td>

                            <td>
                                @session.Instructor.FirstName
                                @session.Instructor.LastName
                            </td>

                            <td>
                                @session.Classroom.Name
                            </td>
                        }

                    </tr>
                </tbody>

            </table>
        </div>
        @if (ViewBag.DroppedEnrollmentCount >= 3)
        {

            <div class="alert alert-info">
                You have reached the maximum number of dropped enrollments. 
                Email the coordinator to enroll again.
            </div>

        }
        else
        {
            @if (isEnrolled)
            {
                <button class="view-course-btn" disabled>
                    <i class="bi bi-check-circle"></i>
                    Already Enrolled
                </button>
            }
            else if (ViewBag.IsCompleted)
            {
                <button class="view-course-btn" disabled>
                    <i class="bi bi-check-circle"></i>
                    Completed
                </button>
            }
            else if (remainingSeats <= 0)
            {
                <button class="view-course-btn"
                        disabled
                        data-enroll-button-for="@Model.Id">

                    <i class="bi bi-x-circle"></i>
                    Full
                </button>
            }
            else
            {
                <form asp-action="Enroll" method="post" class="mt-3">

                    <input type="hidden"
                           name="courseId"
                           value="@Model.Id" />

                    <button type="submit"
                            class="view-course-btn"
                            data-enroll-button-for="@Model.Id">

                        <i class="bi bi-credit-card"></i>
                        Enroll and Pay

                    </button>

                </form>
            }
            
        }

        

    </div>
</div>
