@model IEnumerable<MVC_Application.Models.ViewModels.InstructorFeedbackViewModel>

@{
    ViewData["Title"] = "My Feedbacks";
}

<partial name="_InstructorNav" />

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            <i class="bi bi-chat-left-stars-fill"></i>
            My Feedbacks
        </h2>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">

            No feedbacks submitted yet.

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-6 mb-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <h5 class="fw-bold mb-1">
                                        @item.CourseTitle
                                    </h5>

                                    <small class="text-muted">
                                        By @item.TraineeName
                                    </small>

                                </div>

                                <span class="badge bg-primary fs-6">

                                    ⭐ @item.Rating / 5

                                </span>

                            </div>

                            <hr />

                            <div class="mb-3">

                                <div class="mb-2">

                                    <strong>Content:</strong>

                                    @for (int i = 0; i < item.ContentRating; i++)
                                    {
                                        <span class="text-warning">★</span>
                                    }

                                </div>

                                <div class="mb-2">

                                    <strong>Instructor:</strong>

                                    @for (int i = 0; i < item.InstructorRating; i++)
                                    {
                                        <span class="text-warning">★</span>
                                    }

                                </div>

                                <div class="mb-2">

                                    <strong>Organization:</strong>

                                    @for (int i = 0; i < item.OrganizationRating; i++)
                                    {
                                        <span class="text-warning">★</span>
                                    }

                                </div>

                            </div>

                            <div class="mb-3">

                                <span class="fw-semibold">
                                    Recommended:
                                </span>

                                @if (item.RecommendCourse)
                                {
                                    <span class="badge bg-success">
                                        Yes 👍
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        No 👎
                                    </span>
                                }

                            </div>

                            <div class="bg-light rounded-3 p-3 mb-3">

                                <p class="mb-0">
                                    @item.Comment
                                </p>

                            </div>

                            <small class="text-muted">

                                Submitted:
                                @item.CreatedAt.ToString("dd MMM yyyy")

                            </small>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>