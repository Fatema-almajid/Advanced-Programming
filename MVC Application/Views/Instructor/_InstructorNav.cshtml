@using System.Security.Claims

<nav class="navbar navbar-expand-lg navbar-light bg-white border rounded shadow-sm mb-4 px-3">
    <div class="container-fluid">
        <span class="navbar-brand fw-semibold">
            <i class="bi bi-person-circle"></i>
            @(User.FindFirst(ClaimTypes.Name)?.Value ?? "Instructor")
        </span>

        <div class="navbar-nav">
            <a class="nav-link" asp-controller="Instructor" asp-action="Dashboard">
                Dashboard
            </a>

            <a class="nav-link" asp-controller="Instructor" asp-action="MyCourses">
                My Courses
            </a>

            <a class="nav-link" asp-controller="Instructor" asp-action="Schedule">
                Schedule
            </a>

            <a asp-controller="Instructor" asp-action="MyNotifications" class="nav-link position-relative">
                <i class="bi bi-bell-fill fs-5"></i>
                <span id="notification-count" class="badge bg-danger d-none">0</span>
            </a>
        </div>

        <div class="navbar-nav ms-auto">
            <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                Logout
            </a>
        </div>
    </div>
</nav>